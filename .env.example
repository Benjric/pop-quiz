# Postgres connection string. Local dev uses a local server; on Vercel the
# Neon integration sets both of these for you (free tier).
DATABASE_URL="postgresql://user:password@localhost:5432/popquiz?schema=public"
DATABASE_URL_UNPOOLED=""

# NextAuth v5 signing secret. Generate with: npx auth secret
AUTH_SECRET=""

# Ably (free tier) for live game updates. Create an app at ably.com and copy
# its root API key. Leave empty locally to fall back to polling.
ABLY_API_KEY=""

# Your teacher login, used only by `npm run seed`.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Your Name"
